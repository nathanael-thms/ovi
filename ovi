import argparse
import curses
import os
import sys

# Check if we are already running inside a virtual environment
if sys.prefix == sys.base_prefix:
    # Use realpath to resolve the true folder if ovi is symlinked
    real_script_path = os.path.realpath(__file__)
    script_dir = os.path.dirname(real_script_path)
    VENV_PYTHON = os.path.join(script_dir, "ovi-env", "bin", "python")

    if os.path.exists(VENV_PYTHON):
        # Relaunch the script using the venv's Python, passing all arguments
        os.execv(VENV_PYTHON, [VENV_PYTHON] + sys.argv)
    else:
        sys.exit(f"Error: Virtual environment not found at {VENV_PYTHON}. Please run setup.sh first.")

os.environ.setdefault('ESCDELAY', '25')

script_path = os.path.realpath(__file__)
script_dir = os.path.dirname(script_path)
if script_dir not in sys.path:
    sys.path.insert(0, script_dir)

from ovi_core import chat
from ovi_core.menu import draw_menu
from ovi_core.path import get_models_root

models_dir = get_models_root()

def main_menu(stdscr: curses.window) -> str:
    # Set up the terminal for menu navigation, and draw the initial menu
    stdscr.keypad(True)
    
    options = ["Launch a model", "Exit"]
    current_row = 0

    while True:
        draw_menu(stdscr, current_row, options)
        key = stdscr.getch()

        if key == curses.KEY_UP:
            current_row = (current_row - 1) % len(options)
        elif key == curses.KEY_DOWN:
            current_row = (current_row + 1) % len(options)
        elif key in [curses.KEY_ENTER, 10, 13]:
            return options[current_row]
        elif key in [curses.KEY_LEFT]:
            return "Back"
        elif key in [27, ord('q'), ord('Q')]:
            sys.exit(0)
        
def model_menu(stdscr: curses.window) -> str:
    stdscr.keypad(True)

    # Get the list of available models from the models directory
    models = [d for d in os.listdir(models_dir) if os.path.isdir(os.path.join(models_dir, d))]
    current_row = 0

    if not models:
        stdscr.erase()
        stdscr.addstr(0, 0, "No models found. Press any key to exit")
        stdscr.refresh()
        stdscr.getch()
        return "Exit"

    while True:
        draw_menu(stdscr, current_row, models)
        key = stdscr.getch()

        if key == curses.KEY_UP:
            current_row = (current_row - 1) % len(models)
        elif key == curses.KEY_DOWN:
            current_row = (current_row + 1) % len(models)
        elif key in [curses.KEY_ENTER, 10, 13]:
            return models[current_row]
        elif key in [curses.KEY_LEFT]:
            return "Back"
        elif key in [27, ord('q'), ord('Q')]:
            sys.exit(0)

def option_run() -> None:
    print("Launching model menu...")
    selected_model = curses.wrapper(model_menu)

    if selected_model == "Back" or selected_model == "Exit":
        return

    print("Launching chat for model: " + selected_model)
    chat.start_chat_loop(model_name=selected_model)

def main() -> None:
    # Intercept "help" and convert it to "-h" for argparse compatibility
    if len(sys.argv) > 1 and sys.argv[1] == "help":
        sys.argv[1] = "-h"

    # Parse command-line arguments
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--is-ovi-install",
        action="store_true",
        help="Check if this is an ovi installation, used by setup.sh for validation"
    )

    subparsers = parser.add_subparsers(dest="command")
    run_parser = subparsers.add_parser("run", help="Run a model")
    run_parser.add_argument("model_name", nargs="?", help="Optional model name to launch directly")

    args = parser.parse_args()
    # Handle the main application flow
    if args.is_ovi_install:
        print("True")
    elif args.command == "run" and args.model_name:
        # Directly launch the chat loop if a model has been specified
        chat.start_chat_loop(model_name=args.model_name)
    elif args.command == "run":
        option_run()
    else:
        try:
            option = curses.wrapper(main_menu)

            if option == "Exit":
                print("Exiting ovi")
                sys.exit(0)
            elif option == "Launch a model":
                option_run()

        except KeyboardInterrupt:
            print("Caught KeyboardInterrupt. Exiting ovi")
            sys.exit(0)

if __name__ == "__main__":
    main()
