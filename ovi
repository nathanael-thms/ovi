#!/usr/bin/env python3

import argparse
import curses
import os 
import sys

os.environ.setdefault('ESCDELAY', '25') 

def draw_menu(stdscr: curses.window, selected_index: int, options: list[str]) -> None:
    stdscr.move(0, 0)
    stdscr.clrtobot()
    curses.curs_set(0)

    height, width = stdscr.getmaxyx()
    if width < 20 or height < len(options) + 3:
        stdscr.addstr("Terminal too small!")
        stdscr.refresh()
        return

    line_width = min(60, width - 1)

    stdscr.addstr("↑/↓ navigate • enter launch • → configure • esc/q quit.\n", curses.A_DIM)
    stdscr.addstr("=" * line_width + "\n\n")

    for index, option in enumerate(options):
        if index == selected_index:
            stdscr.addstr(f" > {option} < \n", curses.A_REVERSE | curses.A_BOLD)
        else:
            stdscr.addstr(f"   {option}   \n")
            
    stdscr.refresh()

def main_menu(stdscr: curses.window) -> str:
    stdscr.keypad(True)
    
    options = ["Launch a model", "Exit"]
    current_row = 0

    while True:
        draw_menu(stdscr, current_row, options)
        key = stdscr.getch()

        if key == curses.KEY_UP:
            current_row = (current_row - 1) % len(options)
        elif key == curses.KEY_DOWN:
            current_row = (current_row + 1) % len(options)
        elif key in [curses.KEY_ENTER, 10, 13]:
            return options[current_row]
        elif key in [27, ord('q'), ord('Q')]:
            return "Exit"

def main() -> None:
    parser = argparse.ArgumentParser()

    parser.add_argument(
        "--is-ovi-install",
        action="store_true",
        help="Check if this is an ovi installation, used by setup.sh for validation"
    )

    parser.add_argument(
        "run",
        nargs="?",
        choices=["run"],
        help="Run a model"
    )

    args = parser.parse_args()

    if args.is_ovi_install:
        print("True")
    elif args.run == "run":
        print("Running a model")
    else:
        try:
            option = curses.wrapper(main_menu)
            
            if option == "Exit":
                print("Exiting application.")
                sys.exit(0)
            elif option == "Launch a model":
                print("Launching a model")
                
        except KeyboardInterrupt:
            print("Operation cancelled by user. Exiting.")
            sys.exit(0)

if __name__ == "__main__":
    main()
